{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run iOS",
            "type": "reactnative",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "platform": "ios",
            "enableDebug": false,
            "runArguments": ["--simulator", "iPhone 17"]
        },
        {
            "name": "Debug iOS",
            "type": "reactnative",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "platform": "ios",
            "enableDebug": true,
            "jsDebugTrace": false,
            "runArguments": ["--simulator", "iPhone 17"]
        },
        {
            "name": "Run Android",
            "type": "reactnative",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "platform": "android",
            "enableDebug": false
        },
        {
            "name": "Debug Android",
            "type": "reactnative",
            "request": "launch",
            "cwd": "${workspaceFolder}/mobile",
            "platform": "android",
            "enableDebug": true,
            "jsDebugTrace": true
        }
    ]
}
