{
  "global": {
    "yellow": {
      "50":  { "$value": "#FFFDE7", "$type": "color", "$description": "Yellow 50 — background suave" },
      "100": { "$value": "#FFF9C4", "$type": "color" },
      "200": { "$value": "#FFF59D", "$type": "color" },
      "300": { "$value": "#FFF176", "$type": "color" },
      "400": { "$value": "#FFEE58", "$type": "color" },
      "500": { "$value": "#F5C518", "$type": "color", "$description": "Amarelo primário Taxio" },
      "600": { "$value": "#E6B800", "$type": "color" },
      "700": { "$value": "#CC9900", "$type": "color" },
      "800": { "$value": "#A67C00", "$type": "color" },
      "900": { "$value": "#7A5900", "$type": "color" }
    },
    "gray": {
      "50":  { "$value": "#FAFAFA", "$type": "color" },
      "100": { "$value": "#F5F5F5", "$type": "color" },
      "200": { "$value": "#EEEEEE", "$type": "color" },
      "300": { "$value": "#E0E0E0", "$type": "color" },
      "400": { "$value": "#BDBDBD", "$type": "color" },
      "500": { "$value": "#9E9E9E", "$type": "color" },
      "600": { "$value": "#757575", "$type": "color" },
      "700": { "$value": "#616161", "$type": "color" },
      "800": { "$value": "#424242", "$type": "color" },
      "900": { "$value": "#212121", "$type": "color" }
    },
    "white": { "$value": "#FFFFFF", "$type": "color" },
    "black": { "$value": "#000000", "$type": "color" }
  },

  "color": {
    "primary":    { "$value": "{yellow.500}", "$type": "color", "$description": "Cor principal — botões, ícones ativos" },
    "primary-light": { "$value": "{yellow.100}", "$type": "color" },
    "primary-dark":  { "$value": "{yellow.700}", "$type": "color" },
    "on-primary": { "$value": "{gray.900}",   "$type": "color", "$description": "Texto/ícone sobre fundo primário" },

    "background": { "$value": "{white}",      "$type": "color", "$description": "Fundo principal da tela" },
    "surface":    { "$value": "{gray.100}",   "$type": "color", "$description": "Cards, campos, superfícies elevadas" },
    "surface-2":  { "$value": "{gray.200}",   "$type": "color" },

    "text-primary":   { "$value": "{gray.900}", "$type": "color", "$description": "Títulos e corpo" },
    "text-secondary": { "$value": "{gray.600}", "$type": "color", "$description": "Labels secundários, placeholders" },
    "text-disabled":  { "$value": "{gray.400}", "$type": "color" },
    "text-inverse":   { "$value": "{white}",    "$type": "color", "$description": "Texto sobre fundos escuros" },

    "border":         { "$value": "{gray.300}", "$type": "color", "$description": "Bordas de campos e cards" },
    "border-focused": { "$value": "{yellow.500}", "$type": "color" },

    "error":       { "$value": "#E53935", "$type": "color" },
    "error-light": { "$value": "#FFEBEE", "$type": "color" },
    "success":     { "$value": "#43A047", "$type": "color" },
    "warning":     { "$value": "#FB8C00", "$type": "color" },
    "info":        { "$value": "#1E88E5", "$type": "color" }
  },

  "spacing": {
    "0":   { "$value": "0",  "$type": "spacing" },
    "1":   { "$value": "2",  "$type": "spacing" },
    "2":   { "$value": "4",  "$type": "spacing", "$description": "xs" },
    "3":   { "$value": "8",  "$type": "spacing", "$description": "sm" },
    "4":   { "$value": "12", "$type": "spacing" },
    "5":   { "$value": "16", "$type": "spacing", "$description": "md" },
    "6":   { "$value": "20", "$type": "spacing" },
    "7":   { "$value": "24", "$type": "spacing", "$description": "lg" },
    "8":   { "$value": "32", "$type": "spacing", "$description": "xl" },
    "9":   { "$value": "40", "$type": "spacing" },
    "10":  { "$value": "48", "$type": "spacing", "$description": "2xl" },
    "12":  { "$value": "64", "$type": "spacing" },
    "16":  { "$value": "80", "$type": "spacing" }
  },

  "borderRadius": {
    "none":   { "$value": "0",   "$type": "borderRadius" },
    "sm":     { "$value": "4",   "$type": "borderRadius" },
    "md":     { "$value": "8",   "$type": "borderRadius" },
    "lg":     { "$value": "12",  "$type": "borderRadius" },
    "xl":     { "$value": "16",  "$type": "borderRadius" },
    "2xl":    { "$value": "24",  "$type": "borderRadius" },
    "full":   { "$value": "999", "$type": "borderRadius", "$description": "Pílulas e avatares circulares" }
  },

  "borderWidth": {
    "none":   { "$value": "0", "$type": "borderWidth" },
    "sm":     { "$value": "1", "$type": "borderWidth" },
    "md":     { "$value": "2", "$type": "borderWidth" },
    "lg":     { "$value": "4", "$type": "borderWidth" }
  },

  "shadow": {
    "sm": {
      "$value": {
        "x": "0", "y": "1", "blur": "3", "spread": "0",
        "color": "#00000014", "type": "dropShadow"
      },
      "$type": "shadow"
    },
    "md": {
      "$value": {
        "x": "0", "y": "4", "blur": "12", "spread": "0",
        "color": "#0000001A", "type": "dropShadow"
      },
      "$type": "shadow"
    },
    "lg": {
      "$value": {
        "x": "0", "y": "8", "blur": "24", "spread": "-4",
        "color": "#00000020", "type": "dropShadow"
      },
      "$type": "shadow"
    },
    "card": {
      "$value": {
        "x": "0", "y": "2", "blur": "8", "spread": "0",
        "color": "#0000000F", "type": "dropShadow"
      },
      "$type": "shadow"
    }
  },

  "typography": {
    "fontFamily": {
      "sans": { "$value": "Inter", "$type": "fontFamily", "$description": "Fonte principal — fallback: SF Pro, Poppins, sans-serif" }
    },
    "fontSize": {
      "xs":   { "$value": "10", "$type": "fontSizes" },
      "sm":   { "$value": "12", "$type": "fontSizes" },
      "md":   { "$value": "14", "$type": "fontSizes" },
      "base": { "$value": "16", "$type": "fontSizes" },
      "lg":   { "$value": "18", "$type": "fontSizes" },
      "xl":   { "$value": "20", "$type": "fontSizes" },
      "2xl":  { "$value": "24", "$type": "fontSizes" },
      "3xl":  { "$value": "28", "$type": "fontSizes" },
      "4xl":  { "$value": "32", "$type": "fontSizes" }
    },
    "fontWeight": {
      "regular":   { "$value": "400", "$type": "fontWeights" },
      "medium":    { "$value": "500", "$type": "fontWeights" },
      "semibold":  { "$value": "600", "$type": "fontWeights" },
      "bold":      { "$value": "700", "$type": "fontWeights" }
    },
    "lineHeight": {
      "tight":   { "$value": "120%", "$type": "lineHeights" },
      "snug":    { "$value": "140%", "$type": "lineHeights" },
      "normal":  { "$value": "150%", "$type": "lineHeights" },
      "relaxed": { "$value": "160%", "$type": "lineHeights" }
    },
    "letterSpacing": {
      "tight":  { "$value": "-0.02em", "$type": "letterSpacing" },
      "normal": { "$value": "0",       "$type": "letterSpacing" },
      "wide":   { "$value": "0.04em",  "$type": "letterSpacing" },
      "wider":  { "$value": "0.08em",  "$type": "letterSpacing" }
    }
  },

  "textStyle": {
    "display-lg": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.4xl}",
        "fontWeight": "{typography.fontWeight.bold}",
        "lineHeight": "{typography.lineHeight.tight}",
        "letterSpacing": "{typography.letterSpacing.tight}"
      },
      "$type": "typography",
      "$description": "Display grande — telas de boas-vindas"
    },
    "heading-1": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.3xl}",
        "fontWeight": "{typography.fontWeight.bold}",
        "lineHeight": "{typography.lineHeight.tight}",
        "letterSpacing": "{typography.letterSpacing.tight}"
      },
      "$type": "typography"
    },
    "heading-2": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.2xl}",
        "fontWeight": "{typography.fontWeight.semibold}",
        "lineHeight": "{typography.lineHeight.snug}",
        "letterSpacing": "{typography.letterSpacing.tight}"
      },
      "$type": "typography"
    },
    "heading-3": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.xl}",
        "fontWeight": "{typography.fontWeight.semibold}",
        "lineHeight": "{typography.lineHeight.snug}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      },
      "$type": "typography"
    },
    "title": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.lg}",
        "fontWeight": "{typography.fontWeight.semibold}",
        "lineHeight": "{typography.lineHeight.snug}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      },
      "$type": "typography"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.base}",
        "fontWeight": "{typography.fontWeight.regular}",
        "lineHeight": "{typography.lineHeight.normal}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      },
      "$type": "typography"
    },
    "body-md": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.md}",
        "fontWeight": "{typography.fontWeight.regular}",
        "lineHeight": "{typography.lineHeight.normal}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      },
      "$type": "typography"
    },
    "body-sm": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.sm}",
        "fontWeight": "{typography.fontWeight.regular}",
        "lineHeight": "{typography.lineHeight.relaxed}",
        "letterSpacing": "{typography.letterSpacing.normal}"
      },
      "$type": "typography"
    },
    "label-lg": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.md}",
        "fontWeight": "{typography.fontWeight.semibold}",
        "lineHeight": "{typography.lineHeight.tight}",
        "letterSpacing": "{typography.letterSpacing.wide}"
      },
      "$type": "typography"
    },
    "label-md": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.sm}",
        "fontWeight": "{typography.fontWeight.medium}",
        "lineHeight": "{typography.lineHeight.tight}",
        "letterSpacing": "{typography.letterSpacing.wide}"
      },
      "$type": "typography"
    },
    "caption": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.xs}",
        "fontWeight": "{typography.fontWeight.regular}",
        "lineHeight": "{typography.lineHeight.normal}",
        "letterSpacing": "{typography.letterSpacing.wider}"
      },
      "$type": "typography"
    },
    "button-lg": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.base}",
        "fontWeight": "{typography.fontWeight.semibold}",
        "lineHeight": "{typography.lineHeight.tight}",
        "letterSpacing": "{typography.letterSpacing.wide}"
      },
      "$type": "typography"
    },
    "button-md": {
      "$value": {
        "fontFamily": "{typography.fontFamily.sans}",
        "fontSize": "{typography.fontSize.md}",
        "fontWeight": "{typography.fontWeight.semibold}",
        "lineHeight": "{typography.lineHeight.tight}",
        "letterSpacing": "{typography.letterSpacing.wide}"
      },
      "$type": "typography"
    }
  },

  "component": {
    "button": {
      "height-sm": { "$value": "36", "$type": "sizing" },
      "height-md": { "$value": "48", "$type": "sizing" },
      "height-lg": { "$value": "56", "$type": "sizing" },
      "padding-x-sm": { "$value": "{spacing.3}", "$type": "spacing" },
      "padding-x-md": { "$value": "{spacing.5}", "$type": "spacing" },
      "padding-x-lg": { "$value": "{spacing.7}", "$type": "spacing" },
      "radius":     { "$value": "{borderRadius.full}", "$type": "borderRadius" },
      "bg-primary": { "$value": "{color.primary}", "$type": "color" },
      "text-primary": { "$value": "{color.on-primary}", "$type": "color" },
      "bg-secondary": { "$value": "{white}", "$type": "color" },
      "border-secondary": { "$value": "{color.border}", "$type": "color" },
      "text-secondary": { "$value": "{color.text-primary}", "$type": "color" },
      "bg-ghost": { "$value": "transparent", "$type": "color" },
      "text-ghost": { "$value": "{color.primary}", "$type": "color" }
    },
    "input": {
      "height":       { "$value": "52", "$type": "sizing" },
      "padding-x":    { "$value": "{spacing.5}", "$type": "spacing" },
      "padding-y":    { "$value": "{spacing.3}", "$type": "spacing" },
      "radius":       { "$value": "{borderRadius.lg}", "$type": "borderRadius" },
      "bg":           { "$value": "{color.surface}", "$type": "color" },
      "border":       { "$value": "{color.border}", "$type": "color" },
      "border-focus": { "$value": "{color.border-focused}", "$type": "color" },
      "text":         { "$value": "{color.text-primary}", "$type": "color" },
      "placeholder":  { "$value": "{color.text-disabled}", "$type": "color" },
      "label":        { "$value": "{color.text-secondary}", "$type": "color" }
    },
    "card": {
      "padding":  { "$value": "{spacing.5}", "$type": "spacing" },
      "radius":   { "$value": "{borderRadius.xl}", "$type": "borderRadius" },
      "bg":       { "$value": "{white}", "$type": "color" },
      "shadow":   { "$value": "{shadow.card}", "$type": "shadow" },
      "border":   { "$value": "{color.border}", "$type": "color" }
    },
    "avatar": {
      "size-xs": { "$value": "24", "$type": "sizing" },
      "size-sm": { "$value": "32", "$type": "sizing" },
      "size-md": { "$value": "40", "$type": "sizing" },
      "size-lg": { "$value": "56", "$type": "sizing" },
      "size-xl": { "$value": "72", "$type": "sizing" },
      "radius":  { "$value": "{borderRadius.full}", "$type": "borderRadius" },
      "bg":      { "$value": "{color.primary-light}", "$type": "color" }
    },
    "bottomNav": {
      "height":        { "$value": "64", "$type": "sizing" },
      "bg":            { "$value": "{white}", "$type": "color" },
      "icon-active":   { "$value": "{color.primary}", "$type": "color" },
      "icon-inactive": { "$value": "{color.text-disabled}", "$type": "color" },
      "label-active":  { "$value": "{color.primary}", "$type": "color" },
      "indicator-bg":  { "$value": "{color.primary-light}", "$type": "color" }
    },
    "badge": {
      "height":    { "$value": "20", "$type": "sizing" },
      "padding-x": { "$value": "{spacing.2}", "$type": "spacing" },
      "radius":    { "$value": "{borderRadius.full}", "$type": "borderRadius" },
      "bg-primary": { "$value": "{color.primary}", "$type": "color" },
      "text":       { "$value": "{color.on-primary}", "$type": "color" }
    },
    "otp": {
      "cell-size":   { "$value": "52", "$type": "sizing" },
      "radius":      { "$value": "{borderRadius.md}", "$type": "borderRadius" },
      "bg":          { "$value": "{color.surface}", "$type": "color" },
      "border":      { "$value": "{color.border}", "$type": "color" },
      "border-active": { "$value": "{color.primary}", "$type": "color" },
      "text":        { "$value": "{color.text-primary}", "$type": "color" }
    }
  }
}
